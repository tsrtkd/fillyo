{
  "rules": {

    "users": {
      ".read": "auth != null && auth.token.email === 'audtls2g@gmail.com'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.token.email === 'audtls2g@gmail.com'",

        // 생성: 본인 계정, 레코드가 없을 때, planType이 'trial'인 경우만
        // 수정: 개별 하위 필드 규칙이 담당 (관리자 이메일은 부모에서 전체 허용)
        ".write": "(auth.uid === $uid && !data.exists() && newData.child('planType').val() === 'trial') || auth.token.email === 'audtls2g@gmail.com'",

        // ── 브라우저가 직접 쓸 수 있는 일반 필드 ────────────────────────────
        "email":     { ".write": "auth.uid === $uid" },
        "ownerName": { ".write": "auth.uid === $uid" },
        "phone":     { ".write": "auth.uid === $uid" },
        "address":   { ".write": "auth.uid === $uid" },

        // academyId: 최초 1회 연결만 허용
        // .validate: null(가입 초기값) 또는 해당 아카데미의 members에서 본인이 'owner'일 때만
        //   setup은 academies를 먼저 만든 뒤 users.academyId를 씀 → validate 평가 시점엔 이미 members.uid==='owner'
        "academyId": {
          ".write": "auth.uid === $uid && !data.exists()",
          ".validate": "auth.token.email === 'audtls2g@gmail.com' || newData.val() === null || root.child('academies').child(newData.val()).child('members').child(auth.uid).val() === 'owner'"
        },

        // trialStart: 최초 1회 기록만 허용 + 미래 값 금지(체험 연장 방지)
        "trialStart": {
          ".write": "auth.uid === $uid && !data.exists()",
          ".validate": "auth.token.email === 'audtls2g@gmail.com' || newData.val() <= now"
        },

        // 공지 읽음 처리
        "readNotices": {
          "$nid": { ".write": "auth.uid === $uid" }
        },

        // ── 민감 필드 — .validate 로 브라우저 직접 쓰기 차단 ─────────────────
        // .validate 는 Admin SDK(Functions)에 적용되지 않으므로 서버 로직은 정상 동작
        "role": {
          ".validate": "auth.token.email === 'audtls2g@gmail.com'"
        },
        // planType: 가입 시 'trial'만, 이후 변경은 Functions(Admin SDK)만
        "planType": {
          ".validate": "auth.token.email === 'audtls2g@gmail.com' || (!data.exists() && newData.val() === 'trial')"
        },
        // planExpiry: 가입 시 최초 설정(≤91일 이내)만, 이후 변경은 Functions만
        // 90일(ms) = 7776000000, 여기선 클럭 오차 여유분 포함 91일 = 7862400000
        "planExpiry": {
          ".validate": "auth.token.email === 'audtls2g@gmail.com' || (!data.exists() && newData.val() <= now + 7862400000)"
        },
        "billingKey":   { ".validate": "auth.token.email === 'audtls2g@gmail.com'" },
        "billingCycle": { ".validate": "auth.token.email === 'audtls2g@gmail.com'" },
        "cancelledAt":  { ".validate": "auth.token.email === 'audtls2g@gmail.com'" },
        "withdrawnAt":  { ".validate": "auth.token.email === 'audtls2g@gmail.com'" }
      }
    },

    "academies": {
      "$acadId": {
        // 읽기: 해당 도장 관장님 또는 관리자
        ".read": "auth != null && (root.child('users').child(auth.uid).child('academyId').val() === $acadId || auth.token.email === 'audtls2g@gmail.com')",

        // 쓰기: 해당 도장 관장님
        //   또는 최초 도장 생성: academyId가 null인 사람이 members에 자신을 owner로 등록
        //   (academyId 있는 사람이 추가 도장을 만드는 것 방지)
        //   또는 관리자
        ".write": "auth != null && (root.child('users').child(auth.uid).child('academyId').val() === $acadId || (!data.exists() && newData.child('members').child(auth.uid).val() === 'owner' && root.child('users').child(auth.uid).child('academyId').val() === null) || auth.token.email === 'audtls2g@gmail.com')",

        // Functions(Admin SDK)만 써야 하는 서버 전용 경로
        // .validate 는 Admin SDK 를 통과시키므로 Functions 는 계속 쓸 수 있음
        // billing: nextPaymentAt 등 직접 조작으로 구독 상태 변조 방지
        "billing":  { ".validate": "auth.token.email === 'audtls2g@gmail.com'" },
        "payments": { ".validate": "auth.token.email === 'audtls2g@gmail.com'" },
        "addons":   { ".validate": "auth.token.email === 'audtls2g@gmail.com'" }
      }
    },

    "notices": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "policy": {
      ".read": "auth != null",
      "curated": {
        ".write": "auth != null && auth.token.email === 'audtls2g@gmail.com'"
      }
    },

    // 결제 실패 기록 — 신규 기록만 허용(덮어쓰기 불가), uid 본인 일치 확인
    "failedSubscriptions": {
      ".read": "auth.token.email === 'audtls2g@gmail.com'",
      "$key": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
      }
    },

    // 이하 경로는 Functions(Admin SDK)만 사용 — 브라우저 차단
    "openPriceSlots":         { ".read": false, ".write": false },
    "settlementDue":          { ".read": "auth.token.email === 'audtls2g@gmail.com'", ".write": false },
    "withdrawnAcademies":     { ".read": false, ".write": false },
    "retainedPaymentRecords": { ".read": false, ".write": false },
    "paymentOrders":          { ".read": false, ".write": false },

    // 미래 직원 기능 전역 비밀값 경로 — 브라우저 완전 차단
    "staffSecrets":   { ".read": false, ".write": false },
    "staffRateLimit": { ".read": false, ".write": false }
  }
}
